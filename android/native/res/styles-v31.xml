<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own launch screen first: make it the same plain dark screen (no big
         round icon), so the app's tile and launch animation are the only things you see. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/blank_icon</item>
    </style>
</resources>
