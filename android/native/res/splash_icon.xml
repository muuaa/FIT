<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch screen icon: the app tile at 128dp (same size and place as the app's own
     launch screen and launch animation), inside the 288dp area Android expects. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/splash" android:gravity="center" android:width="128dp" android:height="128dp" />
</layer-list>
